SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Google Maps JavaScript API browser key (HTTP referrer restrictions required).
# Local: http://127.0.0.1:8765/* and http://localhost:8765/*
# Production: add the actual Vercel/custom domain in Google Cloud.
GOOGLE_MAPS_BROWSER_KEY=
# Optional own Google Cloud map ID. DEMO_MAP_ID is the development default.
GOOGLE_MAPS_MAP_ID=
